# Variáveis usadas pelo docker-compose.yml (copie para .env na raiz e preencha).
# O .env da raiz NÃO deve ser versionado.

# Banco de dados (use uma senha forte e única, não "password")
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=cdgdb

# Armazenamento de fotos (nao reutilizar credenciais do Wolfex)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Valores usados no BUILD do frontend e nas URLs das fotos, se usar Compose
VITE_API_BASE_URL=http://localhost:3001/api/v1
PUBLIC_API_URL=http://localhost:3001/api/v1
CORS_ORIGIN=http://localhost:5173
