# PostgreSQL local da VPS; preserve JWT_SECRET antigo para manter as sessoes.
DATABASE_URL=postgresql://garage:SENHA@HOST_INTERNO:5432/cdgdb?schema=public
DIRECT_URL=postgresql://garage:SENHA@HOST_INTERNO:5432/cdgdb?schema=public
JWT_SECRET=PREENCHER_SEGREDO_FORTE
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://ENDERECO_FRONTEND
# URL publica principal do frontend (fallback para QR Codes e retornos de pagamento).
FRONTEND_URL=https://www.coisasdegaragem.com.br
# Inclua /api/v1; sera usado nas URLs persistidas das novas fotos.
PUBLIC_API_URL=https://ENDERECO_BACKEND/api/v1
MINIO_ENDPOINT=HOST_DA_API_S3_SEM_PROTOCOLO
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=PREENCHER
MINIO_SECRET_KEY=PREENCHER
MINIO_BUCKET=coisasdegaragem
# Preserve tambem as demais integracoes do ambiente atual, como Google OAuth.
# Obrigatorio para iniciar; configurar o segredo correspondente na integracao de pagamentos.
ABACATEPAY_WEBHOOK_SECRET=PREENCHER_SEGREDO_FORTE
# Preencher com a chave real antes de habilitar pagamentos.
ABACATEPAY_API_KEY=
